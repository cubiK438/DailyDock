# DailyDock Backend Configuration
DAILYDOCK_ENV=development
DAILYDOCK_HOST=0.0.0.0
DAILYDOCK_PORT=8000
DAILYDOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Core Architecture Settings
DAILYDOCK_LOG_LEVEL=INFO
DAILYDOCK_SHUTDOWN_GRACE_PERIOD=5.0
DAILYDOCK_TASK_MAX_CONCURRENCY=5
DAILYDOCK_TASK_MAX_PENDING=20
DAILYDOCK_EVENT_MAX_CONCURRENCY=10

# Database & Persistent Storage Configuration
DAILYDOCK_DATA_DIR=data
DAILYDOCK_DATABASE_URL=sqlite+aiosqlite:///data/dailydock.db
DAILYDOCK_DATABASE_ECHO=false
DAILYDOCK_DATABASE_BUSY_TIMEOUT=5000
DAILYDOCK_DATABASE_WAL_ENABLED=true
