# DailyDock Backend Configuration
DAILYDOCK_ENV=development
DAILYDOCK_HOST=0.0.0.0
DAILYDOCK_PORT=8000
DAILYDOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Core Architecture Settings
DAILYDOCK_LOG_LEVEL=INFO
DAILYDOCK_SHUTDOWN_GRACE_PERIOD=5.0
DAILYDOCK_TASK_MAX_CONCURRENCY=5
DAILYDOCK_TASK_MAX_PENDING=20
DAILYDOCK_EVENT_MAX_CONCURRENCY=10

# Database & Persistent Storage Configuration
DAILYDOCK_DATA_DIR=data
DAILYDOCK_DATABASE_URL=sqlite+aiosqlite:///data/dailydock.db
DAILYDOCK_DATABASE_ECHO=false
DAILYDOCK_DATABASE_BUSY_TIMEOUT=5000
DAILYDOCK_DATABASE_WAL_ENABLED=true

# External storage volume (configure the UUID and mountpoint for this host)
DAILYDOCK_STORAGE_MOUNTPOINT=/mnt/dailydock
DAILYDOCK_STORAGE_VOLUME_UUID=
DAILYDOCK_STORAGE_DIRECTORY_NAME=dailydock
DAILYDOCK_STORAGE_CHECK_INTERVAL=30
DAILYDOCK_STORAGE_MARKER_PATH=

# Infrastructure monitoring
DAILYDOCK_MONITOR_ENABLED=true
DAILYDOCK_MONITOR_MAX_CONCURRENCY=2
DAILYDOCK_MONITOR_SYSTEM_INTERVAL=30
DAILYDOCK_MONITOR_STORAGE_INTERVAL=60
DAILYDOCK_MONITOR_CONNECTIVITY_INTERVAL=30
DAILYDOCK_MONITOR_HTTP_INTERVAL=60
DAILYDOCK_MONITOR_SERVICE_INTERVAL=30
DAILYDOCK_MONITOR_CHECK_TIMEOUT=5
DAILYDOCK_MONITOR_STALE_MULTIPLIER=2
DAILYDOCK_MONITOR_FAILURE_THRESHOLD=2
DAILYDOCK_MONITOR_RECOVERY_THRESHOLD=1
DAILYDOCK_MONITOR_CPU_WARNING_PERCENT=80
DAILYDOCK_MONITOR_CPU_CRITICAL_PERCENT=95
DAILYDOCK_MONITOR_RAM_WARNING_PERCENT=80
DAILYDOCK_MONITOR_RAM_CRITICAL_PERCENT=90
DAILYDOCK_MONITOR_STORAGE_WARNING_PERCENT=80
DAILYDOCK_MONITOR_STORAGE_CRITICAL_PERCENT=90
DAILYDOCK_MONITOR_RETENTION_DAYS=30
DAILYDOCK_MONITOR_RETENTION_BATCH_SIZE=500
DAILYDOCK_MONITOR_STORAGE_TARGETS=[]
DAILYDOCK_MONITOR_CONNECTIVITY_PROBES=[]
DAILYDOCK_MONITOR_HTTP_ENDPOINTS=[]
